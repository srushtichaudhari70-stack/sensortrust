# Google Gemini API Key for online reasoning
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model identifier (default: gemini-2.5-flash)
# Supported models: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash
