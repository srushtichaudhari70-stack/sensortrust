# ==============================================================================
# SensorTrust Environment Configuration (.env.example)
# Copy this file to .env and configure your secrets locally.
# NEVER commit .env to version control.
# ==============================================================================

# Google Gemini API Key for online reasoning and voice assistant
# Obtain your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (verified models: gemini-3.5-flash-lite, gemini-3.5-flash, gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Production Server Network Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Allowed CORS Origins (comma-separated, without trailing slashes)
# Example: https://srushtichaudhari70-stack.github.io,https://sensortrust.streamlit.app
CORS_ORIGINS=https://srushtichaudhari70-stack.github.io

# Frontend Connection to Backend (optional, defaults to localhost in development)
BACKEND_URL=http://127.0.0.1:8000
